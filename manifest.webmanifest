{
  "name": "Fardriver Log-Viewer",
  "short_name": "Log-Viewer",
  "description": "Inoffizieller Viewer für Fardriver-Logs aus Worthless Controls",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1a1a19",
  "theme_color": "#1a1a19",
  "lang": "de",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {"name": "logs", "accept": ["text/csv", "text/comma-separated-values", "text/plain", "application/csv", "application/vnd.ms-excel", "application/octet-stream", ".csv"]}
      ]
    }
  }
}
